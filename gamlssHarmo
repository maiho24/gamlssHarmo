#!/usr/bin/env Rscript

get_script_dir <- function() {
  args     <- commandArgs(trailingOnly = FALSE)
  file_arg <- grep("^--file=", args, value = TRUE)
  if (length(file_arg) > 0) {
    script_path <- sub("^--file=", "", file_arg[1])
    return(normalizePath(dirname(normalizePath(script_path, mustWork = FALSE))))
  }
  normalizePath(".")
}

SCRIPT_DIR <- get_script_dir()

print_help <- function() {
  cat("
gamlssHarmo -- GAMLSS-based Harmonisation and Normative Modelling

Usage:
  gamlssHarmo <stage> [options]

Stages:
  diagnose  Diagnose distributional properties and recommend formulas/families
  fit       Fit hierarchical GAMLSS models (one per feature)
  infer     Apply harmonisation and compute normative scores
  plot      Plot pre/post age trajectories

Typical workflow:
  1. gamlssHarmo diagnose --data data/raw/my_data.csv
     -> Inspect output/diagnostics/feature_recommendations.csv
     -> Edit if needed (family_order, nu_terms, tau_terms columns)

  2. gamlssHarmo fit --data data/raw/my_data.csv \\
       --feature-families output/diagnostics/feature_recommendations.csv

  3. gamlssHarmo infer --data data/raw/my_data.csv

  4. gamlssHarmo plot --pre data/raw/my_data.csv \\
       --post output/harmonised/combined_harmonised.csv

Run stage-specific help:
  gamlssHarmo diagnose --help
  gamlssHarmo fit      --help
  gamlssHarmo infer    --help
  gamlssHarmo plot     --help

Skip diagnose if you already know your distributions:
  gamlssHarmo fit --data data/raw/my_data.csv --family_order GG,SHASH,NO
")
}

all_args     <- commandArgs(trailingOnly = TRUE)
valid_stages <- c("diagnose", "fit", "infer", "plot")

if (length(all_args) == 0 || all_args[1] %in% c("--help", "-h")) {
  print_help()
  quit(status = 0)
}

stage <- all_args[1]

if (!stage %in% valid_stages) {
  cat("Unknown stage '", stage, "'. Valid stages: ",
      paste(valid_stages, collapse = ", "), "\n", sep = "")
  quit(status = 1)
}

stage_args <- all_args[-1]

stage_scripts <- list(
  diagnose = file.path(SCRIPT_DIR, "scripts", "00_diagnose.R"),
  fit      = file.path(SCRIPT_DIR, "scripts", "01_fit.R"),
  infer    = file.path(SCRIPT_DIR, "scripts", "02_infer.R"),
  plot     = file.path(SCRIPT_DIR, "scripts", "03_plot.R")
)

runner <- stage_scripts[[stage]]

if (!file.exists(runner))
  stop("Runner script not found: ", runner)

args_str <- paste(sapply(stage_args, shQuote), collapse = " ")
cmd      <- paste("Rscript", shQuote(runner), args_str)

quit(status = system(cmd))